# ============================================================
# نموذج ملف البيئة — انسخه إلى .env واملأ القيم الحقيقية
#   cp backend/.env.example backend/.env
# ============================================================

PORT=5000

# قاعدة البيانات — MongoDB
# محلي:  mongodb://localhost:27017/beautyhub
# كلاود: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/beautyhub
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/beautyhub?retryWrites=true&w=majority

# مفتاح تشفير الجلسات — استخدم قيمة عشوائية قوية
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# روابط الخدمات (تسجيل الدخول الاجتماعي / الإيميل)
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# تسجيل الدخول الاجتماعي (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# البريد الإلكتروني (اختياري — لإرسال رابط إعادة تعيين كلمة السر)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password